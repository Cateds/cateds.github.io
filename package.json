{
  "name": "host-page",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-remote-assets.mjs && astro dev",
    "build": "node scripts/fetch-remote-assets.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt && prettier --write --log-level warn \"**/*.astro\"",
    "fmt:check": "oxfmt --check && prettier --check \"**/*.astro\"",
    "ci": "bun run fmt:check && bun run lint && bun run check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.3",
    "@astrojs/svelte": "9.0.1",
    "@fontsource-variable/bodoni-moda": "5.3.0",
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@fontsource/maple-mono": "5.2.6",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@lucide/svelte": "1.55.0",
    "@material/material-color-utilities": "0.4.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "bits-ui": "2.18.0",
    "cn": "0.3.0",
    "mathjax": "4.1.3",
    "svelte": "5.57.2",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24",
    "@webgpu/types": "0.1.74",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "shadcn-svelte": "1.7.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  }
}
