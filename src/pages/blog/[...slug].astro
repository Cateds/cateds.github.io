---
import { getCollection, render } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import { siteConfig } from "../../config";
import { readingMinutes } from "../../lib/reading";

export async function getStaticPaths() {
  if (!siteConfig.features.blog) return [];
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { profile } = siteConfig;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const minutes = readingMinutes(post.body);
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PageLayout
  title={`${post.data.title} · ${profile.name}`}
  description={post.data.description}
  currentPath="/blog"
  sky="quiet"
>
  <article class="post">
    <header class="post-header">
      <a href="/blog" class="back eyebrow focus-in" style="--d:0">
        ← All posts
      </a>
      <h1 class="display post-title focus-in" style="--d:1">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="post-lede focus-in" style="--d:2">
          {post.data.description}
        </p>
      )}
      <div class="post-meta eyebrow focus-in" style="--d:3">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span>{minutes} min read</span>
        {post.data.tags.map((tag: string) => (
          <span class="post-tag">{tag}</span>
        ))}
      </div>
    </header>

    <div class="post-layout focus-in" style="--d:4">
      <div class="post-content pane" data-post-content>
        <Content />
      </div>

      {tocHeadings.length > 0 && (
        <aside class="post-toc" aria-label="Table of contents">
          <div class="toc-sticky" data-post-toc>
            <div class="toc-header">
              <span class="eyebrow">On this page</span>
              <span class="eyebrow" data-reading-percentage>
                0%
              </span>
            </div>
            <nav class="toc-nav">
              <span class="toc-track" aria-hidden="true">
                <span class="toc-progress" />
              </span>
              <ol class="toc-list">
                {tocHeadings.map((heading) => (
                  <li>
                    <a
                      href={`#${heading.slug}`}
                      class:list={["toc-link", { "toc-link-nested": heading.depth === 3 }]}
                      data-toc-link
                      data-heading-id={heading.slug}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>
      )}
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back eyebrow">
        ← All posts
      </a>
    </footer>
  </article>
</PageLayout>

<style>
  .post-header {
    display: grid;
    gap: 1.125rem;
    max-width: 52rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .back {
    width: fit-content;
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  .post-title {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    line-height: 1;
    text-wrap: balance;
  }

  .post-lede {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--ink-2);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .post-tag {
    color: var(--accent);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }

  .post-content {
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    --card-blur: 28px;
    background-color: var(--reading-glass);
    line-height: 1.85;
    font-size: 1.0625rem;
  }

  .post-content > :global(*) {
    max-width: 70ch;
  }

  .post-content > :global(pre),
  .post-content > :global(table),
  .post-content > :global(img),
  .post-content > :global(mjx-container[display="true"]) {
    max-width: 100%;
  }

  .post-content > :global(:first-child) {
    margin-top: 0;
  }

  .post-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 500;
    line-height: 1.15;
    margin: 3rem 0 1rem;
  }

  .post-content :global(h3) {
    font-size: 1.1875rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  .post-content :global(p),
  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.375rem;
  }

  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(li) {
    margin-bottom: 0.375rem;
  }

  .post-content :global(li::marker) {
    color: var(--accent);
  }

  .post-content :global(strong) {
    font-weight: 620;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--muted);
  }

  .post-content :global(pre) {
    margin: 1.5rem 0;
    padding: 1rem 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-ui);
  }

  .post-content :global(pre code) {
    display: block;
    min-width: max-content;
    padding: 0;
    border: 0;
    background: none;
  }

  .post-content :global(.astro-code) {
    color: var(--shiki-light) !important;
    background: var(--muted) !important;
  }

  .post-content :global(.astro-code span) {
    color: var(--shiki-light) !important;
    background-color: transparent !important;
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
  }

  :global([data-theme="dark"]) .post-content :global(.astro-code),
  :global([data-theme="dark"]) .post-content :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }

  .post-content :global(.astro-code .code-line) {
    display: block;
    position: relative;
    min-height: 1em;
    padding: 0.2em 1.5rem 0.2em 4rem;
  }

  .post-content :global(.astro-code .code-line::before) {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 2.75rem;
    padding-right: 0.75rem;
    border-right: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 0.75em;
    text-align: right;
    user-select: none;
  }

  .post-content :global(blockquote) {
    margin: 1.75rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    border-left: 1px solid var(--accent);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--ink-2);
  }

  .post-content :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .post-content :global(hr) {
    height: 1px;
    margin: 2.5rem 0;
    border: 0;
    background: var(--line);
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-ui);
  }

  .post-content :global(table) {
    width: 100%;
    margin: 1.75rem 0;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }

  .post-content :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .post-content :global(mjx-container) {
    overflow-x: auto;
    overflow-y: hidden;
  }

  .post-content :global(mjx-container[display="true"]) {
    margin: 1.5rem auto;
    padding: 0.75rem 0;
  }

  .toc-sticky {
    position: sticky;
    top: 2rem;
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .toc-nav {
    position: relative;
  }

  .toc-track {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    width: 1px;
    background: var(--line);
  }

  .toc-progress {
    display: block;
    width: 1px;
    height: var(--reading-progress, 0%);
    background: linear-gradient(180deg, var(--accent-2), var(--accent));
    transition: height 0.12s linear;
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-link {
    display: block;
    padding: 0.3rem 0 0.3rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ink-3);
    transition:
      color 0.2s ease,
      transform 0.3s var(--ease-focus);
  }

  .toc-link:hover {
    color: var(--ink);
  }

  .toc-link:global(.active) {
    color: var(--accent);
    transform: translateX(2px);
  }

  .toc-link-nested {
    padding-left: 1.75rem;
    font-size: 0.75rem;
  }

  .post-footer {
    margin-top: 2.5rem;
  }

  @media (max-width: 1240px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-toc {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .post-content {
      margin-inline: calc(-1 * clamp(1.25rem, 4vw, 3rem));
      border-inline: 0;
      border-radius: 0;
      font-size: 1rem;
    }

    .post-content :global(.astro-code .code-line) {
      padding-left: 3.5rem;
      padding-right: 1rem;
    }
  }
</style>

<script>
  let tocController: AbortController | undefined;

  const initializePostToc = () => {
    tocController?.abort();

    const content = document.querySelector<HTMLElement>("[data-post-content]");
    const toc = document.querySelector<HTMLElement>("[data-post-toc]");
    if (!content || !toc) return;

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const entries = links
      .map((link) => ({
        link,
        heading: document.getElementById(link.dataset.headingId || ""),
      }))
      .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } =>
        Boolean(entry.heading),
      );
    const percentage = toc.querySelector<HTMLElement>("[data-reading-percentage]");

    if (entries.length === 0) return;

    tocController = new AbortController();

    const update = () => {
      const contentRect = content.getBoundingClientRect();
      const contentTop = window.scrollY + contentRect.top;
      const contentBottom = contentTop + contentRect.height;
      const start = contentTop - 120;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const end = Math.max(
        start + 1,
        Math.min(contentBottom - window.innerHeight + 120, maxScroll),
      );
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));

      toc.style.setProperty("--reading-progress", `${progress * 100}%`);
      if (percentage) percentage.textContent = `${Math.round(progress * 100)}%`;

      const activationLine = Math.min(180, window.innerHeight * 0.3);
      let active = entries[0];

      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top <= activationLine) active = entry;
      }

      if (window.scrollY >= maxScroll - 2) active = entries[entries.length - 1];

      for (const entry of entries) {
        const isActive = entry === active;
        entry.link.classList.toggle("active", isActive);
        if (isActive) entry.link.setAttribute("aria-current", "location");
        else entry.link.removeAttribute("aria-current");
      }
    };

    window.addEventListener("scroll", update, {
      passive: true,
      signal: tocController.signal,
    });
    window.addEventListener("resize", update, { signal: tocController.signal });
    update();
  };

  document.addEventListener("astro:page-load", initializePostToc);
  initializePostToc();
</script>
