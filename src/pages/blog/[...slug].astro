---
import PageLayout from "../../layouts/PageLayout.astro";
import { siteConfig } from "../../config";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const { features } = siteConfig;
  
  if (!features.blog) {
    return [];
  }
  
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { profile } = siteConfig;

const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);

const readingTime = Math.ceil(
  (post.body?.trim().split(/\s+/).length || 0) / 200,
);

const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PageLayout title={`${post.data.title} - ${profile.name}`} currentPath="/blog">
  <article class="blog-post fade-in-down-short" data-blog-post>
    <header class="post-header">
      <a href="/blog" class="back-link">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          width="16"
          height="16"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to Blog
      </a>

      <h1 class="post-title">{post.data.title}</h1>

      <div class="post-meta">
        <time class="post-date">{formattedDate}</time>

        <span class="post-reading-time">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            width="14"
            height="14"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 6v6l4 2"></path>
          </svg>
          {readingTime} min read
        </span>
      </div>

      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((tag: string) => (
              <span class="post-tag">{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    <div class="post-layout">
      <div class="post-content" data-post-content>
        <Content />
      </div>

      {
        tocHeadings.length > 0 && (
          <aside class="post-toc" aria-label="Table of contents">
            <div class="toc-sticky" data-post-toc>
              <div class="toc-header">
                <span class="toc-title">On this page</span>
                <span class="toc-percentage" data-reading-percentage>0%</span>
              </div>
              <nav class="toc-nav">
                <span class="toc-track" aria-hidden="true">
                  <span class="toc-progress" data-reading-progress />
                </span>
                <ol class="toc-list">
                  {tocHeadings.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={["toc-link", { "toc-link-nested": heading.depth === 3 }]}
                        data-toc-link
                        data-heading-id={heading.slug}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </div>
          </aside>
        )
      }
    </div>

    <footer class="post-footer">
      <a href="/blog" class="back-link">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          width="16"
          height="16"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        Back to Blog
      </a>
    </footer>
  </article>
</PageLayout>

<style>
  .blog-post {
    width: 100%;
    position: relative;
    overflow: clip;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .blog-post::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
  }

  .post-header {
    padding: clamp(2rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .post-header .back-link {
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .post-title {
    max-width: 24ch;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.18;
    margin-bottom: 1.25rem;
    font-family: var(--font-serif);
    letter-spacing: -0.02em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .post-date {
    font-size: 0.9375rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .post-reading-time {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post-tag {
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    background: var(--color-accent-light);
    color: var(--color-accent);
    border-radius: 999px;
    border: 1px solid rgba(122, 154, 170, 0.3);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    align-items: stretch;
  }

  .post-content {
    min-width: 0;
    color: var(--color-text);
    line-height: 1.8;
    padding: clamp(2rem, 4vw, 3.5rem);
  }

  .post-content > :global(*) {
    max-width: 78ch;
    margin-left: auto;
    margin-right: auto;
  }

  .post-content > :global(pre),
  .post-content > :global(table),
  .post-content > :global(img),
  .post-content > :global(mjx-container[display="true"]) {
    max-width: 100%;
  }

  .post-content > :global(:first-child) {
    margin-top: 0;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-family: var(--font-serif);
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    font-family: var(--font-serif);
  }

  .post-content :global(h2),
  .post-content :global(h3) {
    scroll-margin-top: 2rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125rem 0.35rem;
    background: var(--color-accent-light);
    border-radius: 3px;
    border: 1px solid var(--color-border);
  }

  .post-content :global(pre) {
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1;
    padding: 1rem 0;
    background: color-mix(in srgb, var(--color-bg-secondary) 84%, transparent);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    overflow-x: auto;
    /* margin-top: 1.5rem; */
    /* margin-bottom: 1.5rem; */
  }

  .post-content :global(pre code) {
    display: block;
    min-width: max-content;
    padding: 0;
    background: none;
    border: none;
  }

  .post-content :global(.astro-code .code-line) {
    display: block;
    position: relative;
    min-height: 1em;
    margin-bottom: -0.2em;
    padding: 0 1.5rem 0 4.25rem;
  }

  .post-content :global(.astro-code .code-line:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(.astro-code .code-line::before) {
    content: attr(data-line);
    position: absolute;
    left: 0;
    width: 3.25rem;
    padding-right: 0.875rem;
    border-right: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.75em;
    line-height: 1.3333;
    text-align: right;
    user-select: none;
    opacity: 0.65;
  }

  .post-content :global(.astro-code .code-line:hover) {
    background: var(--color-accent-light) !important;
  }

  .post-content :global(.astro-code) {
    color: var(--shiki-light) !important;
    background: color-mix(in srgb, var(--color-bg-secondary) 84%, transparent) !important;
  }

  .post-content :global(.astro-code span) {
    color: var(--shiki-light) !important;
    background-color: transparent !important;
    font-style: var(--shiki-light-font-style);
    font-weight: var(--shiki-light-font-weight);
    text-decoration: var(--shiki-light-text-decoration);
  }

  :global([data-theme="dark"]) .post-content :global(.astro-code),
  :global([data-theme="dark"]) .post-content :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: 0.875rem 1.25rem;
    margin: 1.5rem 0;
    background: var(--color-accent-light);
    border-radius: 0 4px 4px 0;
    color: var(--color-text);
    font-style: normal;
  }

  .post-content :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    text-decoration: none;
  }

  .post-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 2rem 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 5px;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.9375rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .post-content :global(th) {
    color: var(--color-text-secondary);
    font-weight: 600;
    background: var(--color-accent-light);
  }

  .post-content :global(mjx-container) {
    color: var(--color-text);
    overflow-x: auto;
    overflow-y: hidden;
  }

  .post-content :global(mjx-container[display="true"]) {
    padding: 0.75rem 0;
    margin: 1.5rem auto;
  }

  .post-toc {
    min-width: 0;
    border-left: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-secondary) 38%, transparent);
  }

  .toc-sticky {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    padding: 2rem 1.5rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .toc-title {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .toc-percentage {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-secondary);
  }

  .toc-nav {
    position: relative;
  }

  .toc-track {
    position: absolute;
    top: 0.375rem;
    bottom: 0.375rem;
    left: 0;
    width: 1px;
    overflow: hidden;
    background: var(--color-border);
  }

  .toc-progress {
    display: block;
    width: 2px;
    height: var(--reading-progress, 0%);
    background: var(--color-accent);
    transition: height 0.12s linear;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-list li {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.3rem 0 0.3rem 1rem;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.45;
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link:focus-visible {
    border-radius: 3px;
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .toc-link.active {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .toc-link-nested {
    padding-left: 1.75rem;
    font-size: 0.75rem;
  }

  .post-footer {
    padding: 1.25rem clamp(2rem, 4vw, 3.5rem);
    border-top: 1px solid var(--color-border);
  }

  .post-footer .back-link {
    margin: 0;
  }

  @media (max-width: 1100px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-toc {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .blog-post {
      border-radius: var(--radius-md);
    }

    .post-header {
      padding: 1.5rem;
    }

    .post-content {
      padding: 1.5rem;
    }

    .post-footer {
      padding: 1rem 1.25rem;
    }

    .post-title {
      font-size: 1.5rem;
    }

    .post-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.375rem;
    }

    .post-content :global(h2) {
      font-size: 1.25rem;
    }

    .post-content :global(h3) {
      font-size: 1.125rem;
    }

    .post-content :global(.astro-code .code-line) {
      padding-right: 1rem;
      padding-left: 3.5rem;
    }

    .post-content :global(.astro-code .code-line::before) {
      width: 2.75rem;
      padding-right: 0.75rem;
    }
  }
</style>

<script>
  let tocController: AbortController | undefined;

  const initializePostToc = () => {
    tocController?.abort();

    const content = document.querySelector<HTMLElement>("[data-post-content]");
    const toc = document.querySelector<HTMLElement>("[data-post-toc]");
    if (!content || !toc) return;

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const entries = links
      .map((link) => ({
        link,
        heading: document.getElementById(link.dataset.headingId || ""),
      }))
      .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } =>
        Boolean(entry.heading),
      );
    const percentage = toc.querySelector<HTMLElement>("[data-reading-percentage]");

    if (entries.length === 0) return;

    tocController = new AbortController();

    const update = () => {
      const contentRect = content.getBoundingClientRect();
      const contentTop = window.scrollY + contentRect.top;
      const contentBottom = contentTop + contentRect.height;
      const start = contentTop - 120;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const end = Math.max(
        start + 1,
        Math.min(contentBottom - window.innerHeight + 120, maxScroll),
      );
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));

      toc.style.setProperty("--reading-progress", `${progress * 100}%`);
      if (percentage) percentage.textContent = `${Math.round(progress * 100)}%`;

      const activationLine = Math.min(180, window.innerHeight * 0.3);
      let active = entries[0];

      for (const entry of entries) {
        if (entry.heading.getBoundingClientRect().top <= activationLine) active = entry;
      }

      if (window.scrollY >= maxScroll - 2) active = entries[entries.length - 1];

      for (const entry of entries) {
        const isActive = entry === active;
        entry.link.classList.toggle("active", isActive);
        if (isActive) entry.link.setAttribute("aria-current", "location");
        else entry.link.removeAttribute("aria-current");
      }
    };

    window.addEventListener("scroll", update, {
      passive: true,
      signal: tocController.signal,
    });
    window.addEventListener("resize", update, { signal: tocController.signal });
    update();
  };

  document.addEventListener("astro:page-load", initializePostToc);
  initializePostToc();
</script>
