---
import { getCollection } from "astro:content";
import BlogIndex from "../../components/BlogIndex.svelte";
import PageLayout from "../../layouts/PageLayout.astro";
import { siteConfig } from "../../config";
import { readingMinutes } from "../../lib/reading";

const { profile, features } = siteConfig;

if (!features.blog) {
  return Astro.redirect("/");
}

const posts = (await getCollection("blog"))
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.date.toISOString(),
    dateLabel: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
    tags: post.data.tags,
    minutes: readingMinutes(post.body),
  }));

const tags = [...new Set(posts.flatMap((post) => post.tags))];
---

<PageLayout title={`${profile.name} · Blog`} currentPath="/blog">
  <header class="head focus-in" style="--d:0">
    <div class="kicker">
      <span class="kicker-no">04</span>
      <span class="signal-bar" aria-hidden="true" />
      <span class="eyebrow">Working notes</span>
    </div>
    <h1 class="display dispersed title">Blog</h1>
    <p class="lede">{posts.length} posts on tools, tutorials and things I'm learning.</p>
  </header>
  <BlogIndex client:load posts={posts} tags={tags} />
</PageLayout>

<style>
  .head {
    display: grid;
    gap: 0.875rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kicker-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--gold);
  }

  .signal-bar {
    width: 2rem;
    height: 0.3125rem;
  }

  .title {
    font-size: clamp(3.25rem, 7.5vw, 5.75rem);
    line-height: 0.8;
    text-transform: uppercase;
    margin-left: -0.055em;
  }

  .lede {
    max-width: 34rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--gold);
    color: var(--ink-2);
  }
</style>
