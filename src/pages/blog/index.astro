---
import { getCollection } from "astro:content";
import BlogIndex from "../../components/BlogIndex.svelte";
import PageLayout from "../../layouts/PageLayout.astro";
import { siteConfig } from "../../config";
import { readingMinutes } from "../../lib/reading";

const { profile, features } = siteConfig;

if (!features.blog) {
  return Astro.redirect("/");
}

const posts = (await getCollection("blog"))
  .toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    description: post.data.description,
    date: post.data.date.toISOString(),
    dateLabel: post.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    }),
    tags: post.data.tags,
    minutes: readingMinutes(post.body),
  }));

const tags = [...new Set(posts.flatMap((post) => post.tags))];
---

<PageLayout title={`${profile.name} · Blog`} currentPath="/blog">
  <header class="head focus-in" style="--d:0">
    <h1 class="display dispersed title">Blog</h1>
    <p class="lede">{posts.length} posts on tools, tutorials and things I'm learning.</p>
  </header>
  <BlogIndex client:load posts={posts} tags={tags} />
</PageLayout>

<style>
  .head {
    display: grid;
    gap: 0.625rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .title {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
  }

  .lede {
    color: var(--ink-2);
  }
</style>
