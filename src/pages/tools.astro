---
import PageLayout from '../layouts/PageLayout.astro'
import ToolCard from '../components/ToolCard'
import { siteConfig } from '../config'

const { profile, tools, features } = siteConfig

if (!features.tools) {
  return Astro.redirect('/')
}
---

<PageLayout title={`${profile.name} - Tools`} currentPath="/tools">
  <header class="page-header fade-in-down-short">
    <h1 class="page-title">Tools</h1>
    <p class="page-subtitle">Useful utilities and resources</p>
  </header>
  
  <section class="tools-grid" id="tools-grid">
    {tools.map((tool, i) => (
      <div class="tool-item fade-in-down-short" style={`animation-delay: ${i * 0.08}s`}>
        <ToolCard tool={tool} />
      </div>
    ))}
  </section>
</PageLayout>

<script>
  function layoutMasonry() {
    const grid = document.getElementById('tools-grid');
    if (!grid) return;

    const items = Array.from(grid.querySelectorAll('.tool-item')) as HTMLElement[];
    if (!items.length) return;

    const isMobile = window.innerWidth <= 768;
    const colCount = isMobile ? 1 : 2;
    const gap = isMobile ? 12 : 16;

    const heights = items.map((el) => el.offsetHeight);

    grid.innerHTML = '';
    grid.style.display = 'flex';
    grid.style.gap = gap + 'px';

    const cols: HTMLDivElement[] = [];
    const colHeights: number[] = [];

    for (let i = 0; i < colCount; i++) {
      const col = document.createElement('div');
      col.style.flex = '1';
      col.style.display = 'flex';
      col.style.flexDirection = 'column';
      col.style.gap = gap + 'px';
      grid.appendChild(col);
      cols.push(col);
      colHeights.push(0);
    }

    items.forEach((item, i) => {
      const shortest = colHeights.indexOf(Math.min(...colHeights));
      cols[shortest].appendChild(item);
      colHeights[shortest] += heights[i] + gap;
    });
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(layoutMasonry, 150);
  });

  document.addEventListener('astro:page-load', layoutMasonry);
</script>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.375rem;
    font-family: var(--font-serif);
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-size: 1.5rem;
    }

    .page-subtitle {
      font-size: 0.9375rem;
    }
  }
</style>
