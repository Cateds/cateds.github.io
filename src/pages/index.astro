---
import SemesterSection from "../components/SemesterSection.svelte";
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../config";
import { navNumber } from "../lib/nav";
import { parseSemesterName } from "../lib/semester";
import { toneStyle } from "../lib/tone";

const { profile, semesters, features } = siteConfig;
const sectionNo = navNumber(profile, features, "/");

const terms = semesters.map((semester) => ({
  id: semester.id,
  ...parseSemesterName(semester.name),
  subjects: semester.subjects.map((subject) => ({
    id: subject.id,
    name: subject.name,
    description: subject.description,
    url: subject.url,
    tone: toneStyle(subject.color),
  })),
}));

const courseCount = terms.reduce((sum, term) => sum + term.subjects.length, 0);
const published = terms.reduce(
  (sum, term) => sum + term.subjects.filter((subject) => subject.url).length,
  0,
);
---

<PageLayout title={`${profile.name} · Notes`} currentPath="/">
  <header class="page-head">
    <div class="head-main focus-in" style="--d:0">
      <div class="kicker">
        <span class="kicker-no">{sectionNo}</span>
        <span class="signal-bar" aria-hidden="true" />
        <span class="eyebrow">Course archive</span>
      </div>
      <h1 class="display dispersed page-title">Notes</h1>
      <p class="page-sub">Course notes and study material, grouped by semester.</p>
    </div>
    <dl class="stats focus-in" style="--d:1">
      <div>
        <dt class="eyebrow">Terms</dt>
        <dd>{terms.length}</dd>
      </div>
      <div>
        <dt class="eyebrow">Courses</dt>
        <dd>{courseCount}</dd>
      </div>
      <div>
        <dt class="eyebrow">Published</dt>
        <dd>{published}</dd>
      </div>
    </dl>
  </header>

  <section class="terms" aria-label="Semesters">
    {terms.map((term, i) => (
      <SemesterSection
        client:visible
        id={term.id}
        stage={term.stage}
        season={term.season}
        subjects={term.subjects}
        index={i + 1}
        delay={Math.min(i * 2 + 2, 10)}
      />
    ))}
  </section>
</PageLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .head-main {
    display: grid;
    gap: 1rem;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kicker-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--gold);
  }

  .signal-bar {
    width: 2rem;
    height: 0.3125rem;
  }

  .page-title {
    font-size: clamp(3.5rem, 8.5vw, 6.75rem);
    line-height: 0.8;
    text-transform: uppercase;
    margin-left: -0.055em;
  }

  .page-sub {
    max-width: 34rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line-strong);
    color: var(--ink-2);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(5.25rem, 1fr));
    border: 1px solid var(--line-strong);
    background: var(--surface-strong);
    box-shadow: 4px 4px 0 -1px var(--line);
  }

  .stats div {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 1rem 0.875rem;
    border-left: 1px solid var(--line);
  }

  .stats div:first-child {
    border-left: 0;
    color: var(--block-ink);
    background: var(--block);
  }

  .stats div:first-child .eyebrow {
    color: var(--gold);
    opacity: 0.9;
  }

  :global([data-theme="dark"]) .stats div:first-child .eyebrow {
    color: var(--block-ink);
    opacity: 0.6;
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .terms {
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .page-head {
      gap: 1.75rem;
    }

    .stats {
      width: 100%;
    }

    .stats div {
      padding: 0.625rem 0.75rem 0.75rem;
    }

    .stats dd {
      font-size: 1.875rem;
    }
  }
</style>
