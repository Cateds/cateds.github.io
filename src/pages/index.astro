---
import SemesterSection from "../components/SemesterSection.svelte";
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../config";
import { parseSemesterName } from "../lib/semester";
import { toneStyle } from "../lib/tone";

const { profile, semesters } = siteConfig;

const terms = semesters.map((semester) => ({
  id: semester.id,
  ...parseSemesterName(semester.name),
  subjects: semester.subjects.map((subject) => ({
    id: subject.id,
    name: subject.name,
    description: subject.description,
    url: subject.url,
    tone: toneStyle(subject.color),
  })),
}));

const courseCount = terms.reduce((sum, term) => sum + term.subjects.length, 0);
const published = terms.reduce(
  (sum, term) => sum + term.subjects.filter((subject) => subject.url).length,
  0,
);
---

<PageLayout title={`${profile.name} · Notes`} currentPath="/">
  <header class="page-head">
    <div class="focus-in" style="--d:0">
      <h1 class="display dispersed page-title">Notes</h1>
      <p class="page-sub">Course notes and study material, grouped by semester.</p>
    </div>
    <dl class="stats focus-in" style="--d:1">
      <div>
        <dt class="eyebrow">Terms</dt>
        <dd>{terms.length}</dd>
      </div>
      <div>
        <dt class="eyebrow">Courses</dt>
        <dd>{courseCount}</dd>
      </div>
      <div>
        <dt class="eyebrow">Published</dt>
        <dd>{published}</dd>
      </div>
    </dl>
  </header>

  <section class="terms" aria-label="Semesters">
    {terms.map((term, i) => (
      <SemesterSection
        client:visible
        id={term.id}
        stage={term.stage}
        season={term.season}
        subjects={term.subjects}
        delay={Math.min(i * 2 + 2, 10)}
      />
    ))}
  </section>
</PageLayout>

<style>
  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .page-title {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
  }

  .page-sub {
    margin-top: 0.625rem;
    color: var(--ink-2);
  }

  .stats {
    display: flex;
    gap: 2rem;
  }

  .stats div {
    display: grid;
    gap: 0.125rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--line-strong);
  }

  .stats dd {
    font-family: var(--font-display);
    font-size: 1.625rem;
    line-height: 1.1;
    font-variant-numeric: lining-nums;
  }

  .terms {
    border-bottom: 1px solid var(--line);
  }
</style>
