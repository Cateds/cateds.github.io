---
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../config";
import { navNumber } from "../lib/nav";
import { toneStyle } from "../lib/tone";

const { profile, repos, features } = siteConfig;
const sectionNo = navNumber(profile, features, "/repos");

if (!features.repos) {
  return Astro.redirect("/");
}

const languageColors: Record<string, string> = {
  TypeScript: "#3178c6",
  JavaScript: "#f1e05a",
  Python: "#3572a5",
  Rust: "#dea584",
  Go: "#00add8",
  Java: "#b07219",
  C: "#555555",
  "C++": "#f34b7d",
  Shell: "#89e051",
};
---

<PageLayout title={`${profile.name} · Repos`} currentPath="/repos">
  <header class="head focus-in" style="--d:0">
    <div class="kicker">
      <span class="kicker-no">{sectionNo}</span>
      <span class="signal-bar" aria-hidden="true" />
      <span class="eyebrow">Code index</span>
    </div>
    <h1 class="display dispersed title">Repositories</h1>
    <p class="lede">Open source projects and experiments.</p>
  </header>

  <ul class="repos">
    {repos.map((repo, i) => (
      <li class="focus-in" style={`--d:${i + 1}`}>
        <a
          href={repo.url}
          class="repo pane pane-link"
          style={toneStyle(repo.color ?? languageColors[repo.language ?? ""])}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="repo-index eyebrow" aria-hidden="true">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span class="repo-name">{repo.name}</span>
          {repo.description && <span class="repo-desc">{repo.description}</span>}
          <span class="repo-meta eyebrow">
            {repo.language && (
              <span class="lang">
                <i aria-hidden="true" />
                {repo.language}
              </span>
            )}
            {repo.stars !== undefined && <span>★ {repo.stars}</span>}
            {repo.forks !== undefined && <span>⑂ {repo.forks}</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</PageLayout>

<style>
  .head {
    display: grid;
    gap: 0.875rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kicker-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--gold);
  }

  .signal-bar {
    width: 2rem;
    height: 0.3125rem;
  }

  .title {
    font-size: clamp(2.875rem, 6.5vw, 5rem);
    line-height: 0.8;
    text-transform: uppercase;
    margin-left: -0.055em;
  }

  .lede {
    max-width: 34rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--gold);
    color: var(--ink-2);
  }

  .repos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .repos li {
    display: flex;
  }

  .repo {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.375rem 1.125rem 1.5rem;
  }

  .repo.pane-link:hover,
  .repo.pane-link:focus-visible {
    background-color: color-mix(in oklab, var(--card-glass-hover) 91%, var(--tone-wash) 9%);
  }

  .repo::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
    background: var(--tone-line);
    opacity: 0.75;
    transition: width 0.35s var(--ease-focus);
  }

  .repo:hover::before {
    width: 7px;
  }

  .repo-index {
    position: absolute;
    top: 1.125rem;
    right: 1.25rem;
    display: inline-grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding-inline: 0.25rem;
    font-size: 0.5625rem;
    color: var(--bg);
    background: var(--tone-line);
  }

  .repo-name {
    padding-right: 2rem;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--tone-ink);
  }

  .repo-desc {
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .repo-meta {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.875rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lang i {
    width: 6px;
    height: 6px;
    background: var(--tone-line);
  }

  @media (max-width: 640px) {
    .repo {
      min-height: 0;
    }
  }
</style>
