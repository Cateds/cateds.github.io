---
import PageLayout from '../layouts/PageLayout.astro'
import RepoCard from '../components/RepoCard'
import { siteConfig } from '../config'

const { profile, repos, features } = siteConfig

if (!features.repos) {
  return Astro.redirect('/')
}
---

<PageLayout title={`${profile.name} - Repos`} currentPath="/repos">
  <header class="page-header fade-in-down-short">
    <h1 class="page-title">Repositories</h1>
    <p class="page-subtitle">Open source projects and experiments</p>
  </header>
  
  <section class="repos-grid">
    {repos.map((repo, i) => (
      <div class="fade-in-down-short" style={`animation-delay: ${i * 0.08}s`}>
        <RepoCard repo={repo} client:load />
      </div>
    ))}
  </section>

  <footer class="page-footer">
    <p>Built with Astro & SolidJS</p>
  </footer>
</PageLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.375rem;
    font-family: var(--font-serif);
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  .repos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .page-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .page-footer p {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 1.5rem;
    }

    .page-title {
      font-size: 1.5rem;
    }

    .page-subtitle {
      font-size: 0.9375rem;
    }

    .repos-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
