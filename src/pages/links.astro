---
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../config";
import { toneStyle } from "../lib/tone";

const { profile, links, features } = siteConfig;

if (!features.links) {
  return Astro.redirect("/");
}

const host = (url: string) => {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<PageLayout title={`${profile.name} · Links`} currentPath="/links">
  <header class="head focus-in" style="--d:0">
    <h1 class="display dispersed title">Links</h1>
    <p class="lede">Notes sites and blogs by classmates and friends.</p>
  </header>

  <ul class="links">
    {links.map((link, i) => (
      <li class="focus-in" style={`--d:${i + 1}`}>
        <a
          href={link.url}
          class="link pane pane-link"
          style={toneStyle(link.color)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="link-host eyebrow">{host(link.url)}</span>
          <span class="link-name">{link.name}</span>
          {link.description && <span class="link-desc">{link.description}</span>}
          <svg
            class="link-arrow"
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      </li>
    ))}
  </ul>
</PageLayout>

<style>
  .head {
    display: grid;
    gap: 0.625rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .title {
    font-size: clamp(2.75rem, 5vw, 3.75rem);
  }

  .lede {
    color: var(--ink-2);
  }

  /* Masonry via columns: cards keep natural height, reading order is per column. */
  .links {
    columns: 3 16rem;
    column-gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .link {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem 2.75rem 1.375rem 1.375rem;
  }

  .link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.25rem;
    width: 2px;
    border-radius: 0 2px 2px 0;
    height: 1rem;
    background: var(--tone-line);
    transition: height 0.5s var(--ease-focus);
  }

  .link:hover::before {
    height: calc(100% - 2.5rem);
  }

  .link-host {
    color: var(--tone-ink);
  }

  .link-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .link-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .link-arrow {
    position: absolute;
    top: 1.25rem;
    right: 1.125rem;
    color: var(--ink-3);
    transition:
      transform 0.45s var(--ease-focus),
      color 0.2s ease;
  }

  .link:hover .link-arrow {
    color: var(--tone-ink);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .links li {
      margin-bottom: 0.5rem;
    }
  }
</style>
