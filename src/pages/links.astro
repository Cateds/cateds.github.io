---
import PageLayout from "../layouts/PageLayout.astro";
import { siteConfig } from "../config";
import { toneStyle } from "../lib/tone";

const { profile, links, features } = siteConfig;

if (!features.links) {
  return Astro.redirect("/");
}

const host = (url: string) => {
  try {
    return new URL(url).host.replace(/^www\./, "");
  } catch {
    return url;
  }
};
---

<PageLayout title={`${profile.name} · Links`} currentPath="/links">
  <header class="head focus-in" style="--d:0">
    <div class="kicker">
      <span class="kicker-no">03</span>
      <span class="signal-bar" aria-hidden="true" />
      <span class="eyebrow">External index</span>
    </div>
    <h1 class="display dispersed title">Links</h1>
    <p class="lede">Notes sites and blogs by classmates and friends.</p>
  </header>

  <ul class="links">
    {links.map((link, i) => (
      <li class="focus-in" style={`--d:${i + 1}`}>
        <a
          href={link.url}
          class="link pane pane-link"
          style={toneStyle(link.color)}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="link-top">
            <span class="link-host eyebrow">
              <span class="link-no" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              {host(link.url)}
            </span>
            <span class="link-arrow" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <path d="M7 17 17 7M8 7h9v9" />
              </svg>
            </span>
          </span>
          <span class="link-name">{link.name}</span>
          {link.description && <span class="link-desc">{link.description}</span>}
        </a>
      </li>
    ))}
  </ul>
</PageLayout>

<style>
  .head {
    display: grid;
    gap: 0.875rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .kicker-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--gold);
  }

  .signal-bar {
    width: 2rem;
    height: 0.3125rem;
  }

  .title {
    font-size: clamp(3.25rem, 7.5vw, 5.75rem);
    line-height: 0.8;
    text-transform: uppercase;
    margin-left: -0.055em;
  }

  .lede {
    max-width: 34rem;
    padding-left: 0.875rem;
    border-left: 2px solid var(--gold);
    color: var(--ink-2);
  }

  /* Masonry via columns: cards keep natural height, reading order is per column. */
  .links {
    columns: 3 16rem;
    column-gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .link {
    display: grid;
    gap: 0.5rem;
    padding: 1.125rem 1.25rem 1.25rem 1.5rem;
  }

  .link.pane-link:hover,
  .link.pane-link:focus-visible {
    background-color: color-mix(in oklab, var(--card-glass-hover) 91%, var(--tone-wash) 9%);
  }

  /* Tone spine, cut off at the card's hard edge. */
  .link::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 4px;
    height: 100%;
    background: var(--tone-line);
    opacity: 0.75;
    transition: width 0.35s var(--ease-focus);
  }

  .link:hover::before {
    width: 7px;
  }

  .link-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .link-host {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--tone-ink);
    overflow-wrap: anywhere;
  }

  .link-no {
    display: inline-grid;
    place-items: center;
    min-width: 1.375rem;
    height: 1.375rem;
    padding-inline: 0.25rem;
    font-size: 0.5625rem;
    color: var(--bg);
    background: var(--tone-line);
  }

  .link-name {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 750;
    line-height: 1.15;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .link-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--ink-2);
  }

  .link-arrow {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border: 1px solid var(--line-strong);
    color: var(--ink-3);
    transition:
      transform 0.4s var(--ease-focus),
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .link:hover .link-arrow {
    color: var(--block-ink);
    background: var(--block);
    border-color: var(--block);
    transform: translate(2px, -2px);
  }

  @media (max-width: 640px) {
    .links li {
      margin-bottom: 0.5rem;
    }
  }
</style>
