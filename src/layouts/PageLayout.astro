---
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../components/Sidebar.astro";
import Sky from "../components/Sky.svelte";
import { siteConfig } from "../config";

interface Props {
  title: string;
  currentPath: string;
  description?: string;
  sky?: "full" | "quiet";
}

const { title, currentPath, description, sky } = Astro.props;
const { profile, features } = siteConfig;
---

<BaseLayout title={title} description={description} sky={sky}>
  <Sky client:only="svelte" transition:persist="sky" />

  <div class="shell">
    <Sidebar profile={profile} features={features} currentPath={currentPath} />

    <main class="main">
      <div class="column">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>

<style>
  .shell {
    position: relative;
    z-index: 1;
    min-height: 100dvh;
  }

  /* Fills everything right of the sidebar; on very wide screens the column caps and centres. */
  .main {
    position: relative;
    margin-left: var(--sidebar-w);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem);
  }

  .column {
    max-width: 1440px;
    margin-inline: auto;
  }

  @media (max-width: 860px) {
    .main {
      margin-left: 0;
      padding: 1.75rem 1.25rem calc(3rem + env(safe-area-inset-bottom));
    }
  }
</style>
