---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Dim the background sky, for long-form reading pages. */
  sky?: "full" | "quiet";
}

const {
  title = "Personal Notes",
  description = "Course notes and study materials",
  sky = "full",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-sky={sky}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fdfdfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16161e" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const pick = () => {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") return saved;
          return matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };
        const apply = (root) => {
          const theme = pick();
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
        };
        apply(document.documentElement);
        if (!window.__themeSync) {
          // Page exit runs live, before the DOM swap, so frosted glass keeps sampling the
          // sky. Loading and the defocus run in parallel; the swap waits for both.
          const reduce = matchMedia("(prefers-reduced-motion: reduce)");
          document.addEventListener("astro:before-preparation", (e) => {
            if (reduce.matches) return;
            const load = e.loader;
            e.loader = async () => {
              const root = document.documentElement;
              root.dataset.leaving = "";
              const main = document.querySelector("main");
              const out = main
                ? new Promise((done) => {
                    main.addEventListener("animationend", done, { once: true });
                    setTimeout(done, 320);
                  })
                : Promise.resolve();
              await Promise.all([load(), out]);
            };
          });
          document.addEventListener("astro:before-swap", (e) => {
            apply(e.newDocument.documentElement);
          });
          document.addEventListener("astro:after-swap", () => {
            delete document.documentElement.dataset.leaving;
          });
          window.__themeSync = true;
        }
      })();
    </script>
    <link rel="icon" href="https://github.com/Cateds.png" type="image/png" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <slot />
  </body>
</html>
