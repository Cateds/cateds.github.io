---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title?: string
}

const { title = 'Personal Notes' } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personal notes and study materials" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      const getPreferredTheme = () => {
        const savedTheme = localStorage.getItem('theme')
        if (savedTheme === 'light' || savedTheme === 'dark') return savedTheme
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      }

      const applyTheme = root => {
        const theme = getPreferredTheme()
        root.setAttribute('data-theme', theme)
        root.style.colorScheme = theme
      }

      applyTheme(document.documentElement)

      if (!window.__themeSyncInitialized) {
        document.addEventListener('astro:before-swap', event => {
          applyTheme(event.newDocument.documentElement)
        })
        document.addEventListener('astro:after-swap', () => {
          applyTheme(document.documentElement)
        })
        window.__themeSyncInitialized = true
      }
    </script>
    <link rel="icon" href="https://github.com/Cateds.png" type="image/png" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
