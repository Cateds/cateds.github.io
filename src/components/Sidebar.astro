---
import ThemeToggle from "./ThemeToggle.svelte";
import type { Features, Profile } from "../types";
import { visibleNav } from "../lib/nav";

interface Props {
  profile: Profile;
  features: Features;
  currentPath: string;
}

const { profile, features, currentPath } = Astro.props;

// The fetch step also emits a resized WebP next to the source avatar.
const avatarWebp = profile.avatar?.replace(/\.(png|jpe?g)$/i, ".webp");

const nav = visibleNav(profile, features);
const isActive = (path: string) =>
  path === "/" ? currentPath === "/" : currentPath.startsWith(path);
const github = profile.externalLinks.find((link) => link.icon === "github");
const otherLinks = profile.externalLinks.filter((link) => link !== github);
const handle = github ? new URL(github.url).pathname.replace(/^\//, "@") : undefined;
---

<aside class="sidebar">
  <div class="masthead" aria-hidden="true">
    <span class="eyebrow">Personal index</span>
    <span class="masthead-no">№ 01</span>
  </div>

  <div class="identity">
    <div class="avatar-frame">
      <a href="/" class="avatar" aria-label={`${profile.name}, home`} transition:persist="avatar">
        {profile.avatar ? (
          <picture>
            {avatarWebp && <source srcset={avatarWebp} type="image/webp" />}
            <img src={profile.avatar} alt="" width="72" height="72" />
          </picture>
        ) : (
          <span>{profile.name.charAt(0)}</span>
        )}
      </a>
      <span class="avatar-crop avatar-crop-tl" aria-hidden="true"></span>
      <span class="avatar-crop avatar-crop-tr" aria-hidden="true"></span>
      <span class="avatar-crop avatar-crop-bl" aria-hidden="true"></span>
      <span class="avatar-crop avatar-crop-br" aria-hidden="true"></span>
    </div>
    <div class="who">
      <span class="name display">{profile.name}</span>
      {profile.bio && <span class="bio">{profile.bio}</span>}
    </div>
    <div class="quick">
      {github && (
        <a
          href={github.url}
          class="icon-btn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
          </svg>
        </a>
      )}
      <ThemeToggle client:load />
    </div>
  </div>

  <nav class="nav" aria-label="Primary">
    <div class="nav-head">
      <span class="eyebrow">Index</span>
      <span class="nav-rule" aria-hidden="true" />
    </div>
    {nav.map((link, i) => (
      <a
        href={link.path}
        class:list={["nav-link", { active: isActive(link.path) }]}
        aria-current={isActive(link.path) ? "page" : undefined}
      >
        <span class="nav-index" aria-hidden="true">
          {String(i + 1).padStart(2, "0")}
        </span>
        <span class="nav-name">{link.name}</span>
        <span class="nav-tick" aria-hidden="true" />
      </a>
    ))}
  </nav>

  <div class="elsewhere">
    <div class="nav-head">
      <span class="eyebrow">Elsewhere</span>
      <span class="nav-rule" aria-hidden="true" />
    </div>
    {github && (
      <a href={github.url} class="ext" target="_blank" rel="noopener noreferrer">
        <span>GitHub</span>
        <span class="ext-meta">{handle} ↗</span>
      </a>
    )}
    {otherLinks.map((link) => (
      <a href={link.url} class="ext" target="_blank" rel="noopener noreferrer">
        <span>{link.name}</span>
        <span class="ext-meta">↗</span>
      </a>
    ))}
  </div>

  <span class="sidebar-note" aria-hidden="true">
    Personal archive · MMXXVI
  </span>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    width: var(--sidebar-w);
    padding: 2rem 1.5rem 1.5rem;
    border-right: 1px solid var(--line-strong);
    background-color: var(--rail);
    -webkit-backdrop-filter: blur(18px) saturate(1.15);
    backdrop-filter: blur(18px) saturate(1.15);
    overflow-y: auto;
    scrollbar-width: none;
  }

  /* Colour strip along the top edge, like the registration bar of a press sheet. */
  .sidebar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(
      90deg,
      var(--block) 0 58%,
      var(--gold) 58% 80%,
      var(--accent-2) 80% 100%
    );
  }

  .masthead {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.25rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .masthead-no {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--gold);
  }

  .identity {
    display: grid;
    gap: 1.125rem;
  }

  .avatar-frame {
    position: relative;
    width: 76px;
    height: 76px;
    flex: none;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 0;
    border: 1px solid var(--ink);
    overflow: hidden;
    box-shadow: 6px 6px 0 -2px var(--gold);
    transition: box-shadow 0.35s var(--ease-focus);
  }

  .avatar-frame:hover .avatar {
    box-shadow: 8px 8px 0 -2px var(--gold);
  }

  /* Crop marks instead of chromatic ghosts: an image wants a printer's frame. */
  .avatar-crop {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--gold);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      transform 0.35s var(--ease-focus);
  }

  .avatar-crop-tl {
    top: -6px;
    left: -6px;
    border-right: 0;
    border-bottom: 0;
    transform: translate(3px, 3px);
  }

  .avatar-crop-tr {
    top: -6px;
    right: -6px;
    border-left: 0;
    border-bottom: 0;
    transform: translate(-3px, 3px);
  }

  .avatar-crop-bl {
    bottom: -6px;
    left: -6px;
    border-right: 0;
    border-top: 0;
    transform: translate(3px, -3px);
  }

  .avatar-crop-br {
    bottom: -6px;
    right: -6px;
    border-left: 0;
    border-top: 0;
    transform: translate(-3px, -3px);
  }

  .avatar-frame:hover .avatar-crop {
    opacity: 1;
    transform: translate(0, 0);
  }

  .avatar picture {
    display: contents;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .who {
    display: grid;
    gap: 0.375rem;
  }

  .name {
    font-family: var(--font-signature);
    font-optical-sizing: auto;
    font-size: 2.375rem;
    font-weight: 600;
    font-style: italic;
    letter-spacing: -0.03em;
    line-height: 0.92;
  }

  .bio {
    position: relative;
    padding-left: 0.875rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-2);
  }

  .bio::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 0.375rem;
    height: 1px;
    background: var(--gold);
  }

  .quick {
    display: flex;
    gap: 0.25rem;
    margin-left: -0.25rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--ink-2);
    border: 1px solid transparent;
    border-radius: 0;
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .icon-btn:hover {
    color: var(--block-ink);
    background: var(--block);
    border-color: var(--block);
  }

  .nav {
    display: grid;
  }

  .nav-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .nav-rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .nav-link {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-top: 1px solid var(--line);
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      padding 0.35s var(--ease-focus);
  }

  .nav-link:last-child {
    border-bottom: 1px solid var(--line);
  }

  .nav-index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .nav-link:hover {
    padding-left: 0.75rem;
    color: var(--ink);
    background: var(--muted);
  }

  .nav-tick {
    width: 0.875rem;
    height: 1px;
    background: var(--line-strong);
    transition:
      width 0.4s var(--ease-focus),
      background-color 0.3s ease;
  }

  .nav-link:hover .nav-tick {
    width: 1.25rem;
  }

  .nav-link.active {
    color: var(--block-ink);
    background: var(--block);
    border-color: var(--block);
    padding-left: 0.75rem;
  }

  .nav-link.active .nav-index {
    color: var(--gold);
  }

  .nav-link.active .nav-tick {
    width: 1.25rem;
    background: var(--block-ink);
  }

  @media (min-width: 861px) {
    :global([data-theme="dark"]) .nav-link.active .nav-index {
      color: var(--block-ink);
      opacity: 0.55;
    }
  }

  .elsewhere {
    display: grid;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .ext {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.4375rem 0.25rem;
    font-size: 0.75rem;
    letter-spacing: 0.035em;
    color: var(--ink-2);
    border-top: 1px solid var(--line);
    transition:
      color 0.2s ease,
      padding 0.3s var(--ease-focus);
  }

  .ext:hover {
    color: var(--accent);
    padding-left: 0.5rem;
  }

  .elsewhere > .ext:first-of-type {
    border-top: 0;
  }

  .ext-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-3);
  }

  .sidebar-note {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-3);
    opacity: 0.68;
    writing-mode: vertical-rl;
    position: absolute;
    right: 0.4375rem;
    bottom: 1.25rem;
    pointer-events: none;
  }

  /* Mobile: identity row + horizontal tabs, sticky at the top. */
  @media (max-width: 860px) {
    .sidebar {
      position: sticky;
      inset: 0 0 auto;
      width: auto;
      gap: 0;
      padding: calc(0.75rem + env(safe-area-inset-top)) 1.25rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--line-strong);
      background-color: var(--rail);
      -webkit-backdrop-filter: blur(18px) saturate(1.15);
      backdrop-filter: blur(18px) saturate(1.15);
      overflow: visible;
    }

    .sidebar::before {
      height: 3px;
    }

    .masthead,
    .nav-head,
    .sidebar-note {
      display: none;
    }

    .identity {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.75rem;
    }

    .avatar-frame {
      width: 36px;
      height: 36px;
    }

    .avatar {
      width: 100%;
      height: 100%;
      border-color: var(--line-strong);
      box-shadow: 3px 3px 0 -1px var(--gold);
    }

    .avatar-frame:hover .avatar {
      box-shadow: 4px 4px 0 -1px var(--gold);
    }

    .avatar-crop {
      width: 6px;
      height: 6px;
    }

    .avatar-crop-tl {
      top: -4px;
      left: -4px;
    }

    .avatar-crop-tr {
      top: -4px;
      right: -4px;
    }

    .avatar-crop-bl {
      bottom: -4px;
      left: -4px;
    }

    .avatar-crop-br {
      bottom: -4px;
      right: -4px;
    }

    .name {
      font-size: 1.4375rem;
    }

    .bio {
      padding-left: 0;
      font-size: 0.6875rem;
    }

    .bio::before {
      display: none;
    }

    .quick {
      margin: 0;
    }

    .nav {
      display: flex;
      gap: 0.25rem;
      margin-top: 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav-link,
    .nav-link:last-child {
      position: relative;
      grid-template-columns: auto auto;
      gap: 0.375rem;
      padding: 0.5rem 0.5rem 0.625rem;
      border: 0;
    }

    .nav-link:hover,
    .nav-link.active {
      padding-left: 0.5rem;
      background: transparent;
      color: var(--ink);
    }

    .nav-index {
      color: var(--ink-3);
    }

    .sidebar .nav-link.active,
    .sidebar .nav-link.active:hover,
    .sidebar .nav-link.active:focus-visible {
      color: var(--accent);
      background: transparent;
    }

    .sidebar .nav-link.active .nav-index {
      color: var(--gold);
      opacity: 1;
    }

    .nav-tick {
      position: absolute;
      left: 0.5rem;
      right: 0.5rem;
      bottom: -1px;
      width: 0;
    }

    .nav-link:hover .nav-tick {
      width: 0;
    }

    .nav-link.active .nav-tick {
      width: calc(100% - 1rem);
      height: 2px;
      background: var(--accent);
    }

    .ext {
      border: 0;
    }

    .elsewhere {
      display: none;
    }
  }
</style>
